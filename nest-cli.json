{
   "$schema": "https://json.schemastore.org/nest-cli",
   "collection": "@nestjs/schematics",
   "sourceRoot": "apps/gateway/src",
   "compilerOptions": {
      "deleteOutDir": true,
      "webpack": true,
      "builder": "swc",
      "webpackConfigPath": "webpack.config.cjs",
      "tsConfigPath": "apps/gateway/tsconfig.app.json"
   },
   "monorepo": true,
   "root": "apps/gateway",
   "defaultProject": "gateway",
   "projects": {
      "auth": {
         "type": "application",
         "root": "apps/auth",
         "entryFile": "main",
         "sourceRoot": "apps/auth/src",
         "compilerOptions": {
            "tsConfigPath": "apps/auth/tsconfig.app.json"
         }
      },
      "user": {
         "type": "application",
         "root": "apps/user",
         "entryFile": "main",
         "sourceRoot": "apps/user/src",
         "compilerOptions": {
            "tsConfigPath": "apps/user/tsconfig.app.json"
         }
      },
      "common": {
         "type": "library",
         "root": "libs/common",
         "entryFile": "index",
         "sourceRoot": "libs/common/src",
         "compilerOptions": {
            "tsConfigPath": "libs/common/tsconfig.lib.json"
         }
      },
      "gateway": {
         "type": "application",
         "root": "apps/gateway",
         "entryFile": "main",
         "sourceRoot": "apps/gateway/src",
         "compilerOptions": {
            "tsConfigPath": "apps/gateway/tsconfig.app.json"
         }
      },
      "notification": {
         "type": "application",
         "root": "apps/notification",
         "entryFile": "main",
         "sourceRoot": "apps/notification/src",
         "compilerOptions": {
            "tsConfigPath": "apps/notification/tsconfig.app.json"
         }
      },
      "post": {
         "type": "application",
         "root": "apps/post",
         "entryFile": "main",
         "sourceRoot": "apps/post/src",
         "compilerOptions": {
            "tsConfigPath": "apps/post/tsconfig.app.json"
         }
      },
      "search": {
         "type": "application",
         "root": "apps/search",
         "entryFile": "main",
         "sourceRoot": "apps/search/src",
         "compilerOptions": {
            "tsConfigPath": "apps/search/tsconfig.app.json"
         }
      },
      "contracts-auth": {
         "type": "library",
         "root": "libs/contracts/auth",
         "entryFile": "index",
         "sourceRoot": "libs/contracts/auth/src",
         "compilerOptions": {
            "tsConfigPath": "libs/contracts/auth/tsconfig.lib.json"
         }
      },
      "contracts-user": {
         "type": "library",
         "root": "libs/contracts/user",
         "entryFile": "index",
         "sourceRoot": "libs/contracts/user/src",
         "compilerOptions": {
            "tsConfigPath": "libs/contracts/user/tsconfig.lib.json"
         }
      },
      "contracts-notification": {
         "type": "library",
         "root": "libs/contracts/notification",
         "entryFile": "index",
         "sourceRoot": "libs/contracts/notification/src",
         "compilerOptions": {
            "tsConfigPath": "libs/contracts/notification/tsconfig.lib.json"
         }
      },
      "contracts-search": {
         "type": "library",
         "root": "libs/contracts/search",
         "entryFile": "index",
         "sourceRoot": "libs/contracts/search/src",
         "compilerOptions": {
            "tsConfigPath": "libs/contracts/search/tsconfig.lib.json"
         }
      },
      "media": {
         "type": "application",
         "root": "apps/media",
         "entryFile": "main",
         "sourceRoot": "apps/media/src",
         "compilerOptions": {
            "tsConfigPath": "apps/media/tsconfig.app.json"
         }
      },
      "contracts-media": {
         "type": "library",
         "root": "libs/contracts/media",
         "entryFile": "index",
         "sourceRoot": "libs/contracts/media/src",
         "compilerOptions": {
            "tsConfigPath": "libs/contracts/media/tsconfig.lib.json"
         }
      }
   }
}
