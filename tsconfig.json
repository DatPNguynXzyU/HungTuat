{
   "compilerOptions": {
      "module": "nodenext",
      "moduleResolution": "nodenext",
      "resolvePackageJsonExports": true,
      "esModuleInterop": true,
      "isolatedModules": true,
      "declaration": true,
      "removeComments": true,
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "allowSyntheticDefaultImports": true,
      "target": "ES2023",
      "sourceMap": true,
      "outDir": "./dist",
      "baseUrl": "./",
      "incremental": true,
      "skipLibCheck": true,
      "strictNullChecks": true,
      "forceConsistentCasingInFileNames": true,
      "noImplicitAny": true,
      "strictBindCallApply": true,
      "noFallthroughCasesInSwitch": true,
      "paths": {
         "@/*": ["apps/gateway/src/*"],
         "@gateway/*": ["apps/gateway/src/*"],
         "@auth/*": ["apps/auth/src/*"],
         "@auth/prisma-client": ["apps/auth/src/generated/prisma-client"],
         "@auth/prisma-client/*": ["apps/auth/src/generated/prisma-client/*"],
         "@user/*": ["apps/user/src/*"],
         "@user/prisma-client": ["apps/user/src/generated/prisma-client"],
         "@user/prisma-client/*": ["apps/user/src/generated/prisma-client/*"],
         "@common": ["libs/common/src"],
         "@common/*": ["libs/common/src/*"],
         "@app/common": ["libs/common/src"],
         "@app/common/*": ["libs/common/src/*"],
         "@contracts/auth": ["libs/contracts/auth/src"],
         "@contracts/auth/*": ["libs/contracts/auth/src/*"],
         "@contracts/user": ["libs/contracts/user/src"],
         "@contracts/user/*": ["libs/contracts/user/src/*"],
         "@contracts/notification": ["libs/contracts/notification/src"],
         "@contracts/notification/*": ["libs/contracts/notification/src/*"],
         "@contracts/search": ["libs/contracts/search/src"],
         "@contracts/search/*": ["libs/contracts/search/src/*"],
         "@contracts/media": ["libs/contracts/media/src"],
         "@contracts/media/*": ["libs/contracts/media/src/*"],
         "@media/*": ["apps/media/src/*"],
         "@media/prisma-client": ["apps/media/src/generated/prisma-client"],
         "@media/prisma-client/*": ["apps/media/src/generated/prisma-client/*"],
         "@notification/*": ["apps/notification/src/*"],
         "@notification/prisma-client": ["apps/notification/src/generated/prisma-client"],
         "@notification/prisma-client/*": ["apps/notification/src/generated/prisma-client/*"],
         "@post/*": ["apps/post/src/*"],
         "@post/prisma-client": ["apps/post/src/generated/prisma-client"],
         "@post/prisma-client/*": ["apps/post/src/generated/prisma-client/*"],
         "@search/*": ["apps/search/src/*"],
         "@user/domain": ["apps/user/src/domain/index.ts"],
         "@user/domain/*": ["apps/user/src/domain/*"],
         "@user/commands": ["apps/user/src/commands/index.ts"],
         "@user/commands/*": ["apps/user/src/commands/*"],
         "@user/unit-of-work": ["apps/user/src/unit-of-work/index.ts"],
         "@user/unit-of-work/*": ["apps/user/src/unit-of-work/*"],
         "@auth/services/domain": ["apps/auth/src/services/domain/index.ts"],
         "@auth/services/domain/*": ["apps/auth/src/services/domain/*"],
         "@auth/services/infrastructure": ["apps/auth/src/services/infrastructure/index.ts"],
         "@auth/services/infrastructure/*": ["apps/auth/src/services/infrastructure/*"],
         "@user/services": ["apps/user/src/services/index.ts"],
         "@user/services/*": ["apps/user/src/services/*"],
         "@user/services/domain": ["apps/user/src/services/domain/index.ts"],
         "@user/services/domain/*": ["apps/user/src/services/domain/*"],
         "@user/services/infrastructure": ["apps/user/src/services/infrastructure/index.ts"],
         "@user/services/infrastructure/*": ["apps/user/src/services/infrastructure/*"],
         "@user/adapters": ["apps/user/src/adapters/index.ts"],
         "@user/adapters/*": ["apps/user/src/adapters/*"],
         "@user/constants": ["apps/user/src/constants/index.ts"],
         "@user/constants/*": ["apps/user/src/constants/*"],
         "@user/decorators": ["apps/user/src/decorators/index.ts"],
         "@user/decorators/*": ["apps/user/src/decorators/*"],
         "@user/cqrs": ["apps/user/src/cqrs/index.ts"],
         "@user/cqrs/*": ["apps/user/src/cqrs/*"],
         "@user/config": ["apps/user/src/config/index.ts"],
         "@user/config/*": ["apps/user/src/config/*"],
         "@user/logger": ["apps/user/src/logger/index.ts"],
         "@user/logger/*": ["apps/user/src/logger/*"],
         "@user/prisma": ["apps/user/src/prisma/index.ts"],
         "@user/prisma/*": ["apps/user/src/prisma/*"],
         "@user/outbox": ["apps/user/src/outbox/index.ts"],
         "@user/outbox/*": ["apps/user/src/outbox/*"],
         "@user/entities": ["apps/user/src/entities/index.ts"],
         "@user/entities/*": ["apps/user/src/entities/*"],
         "@user/repositories": ["apps/user/src/repositories/index.ts"],
         "@user/repositories/*": ["apps/user/src/repositories/*"],
         "@user/factories": ["apps/user/src/factories/index.ts"],
         "@user/factories/*": ["apps/user/src/factories/*"],
         "@user/sagas": ["apps/user/src/sagas/index.ts"],
         "@user/sagas/*": ["apps/user/src/sagas/*"],
         "@user/chains": ["apps/user/src/chains/index.ts"],
         "@user/chains/*": ["apps/user/src/chains/*"],
         "@user/graph": ["apps/user/src/graph/index.ts"],
         "@user/graph/*": ["apps/user/src/graph/*"],
         "@user/templates": ["apps/user/src/templates/index.ts"],
         "@user/templates/*": ["apps/user/src/templates/*"]
      },
      "jsx": "react-jsx"
   }
}
