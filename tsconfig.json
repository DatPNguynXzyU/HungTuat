{
   "compilerOptions": {
      "module": "nodenext",
      "moduleResolution": "nodenext",
      "resolvePackageJsonExports": true,
      "esModuleInterop": true,
      "isolatedModules": true,
      "declaration": true,
      "removeComments": true,
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "allowSyntheticDefaultImports": true,
      "target": "ES2023",
      "sourceMap": true,
      "outDir": "./dist",
      "baseUrl": "./",
      "incremental": true,
      "skipLibCheck": true,
      "strictNullChecks": true,
      "forceConsistentCasingInFileNames": true,
      "noImplicitAny": true,
      "strictBindCallApply": true,
      "noFallthroughCasesInSwitch": true,
      "paths": {
         "@/*": ["apps/gateway/src/*"],
         "@gateway/*": ["apps/gateway/src/*"],
         "@auth/*": ["apps/auth/src/*"],
         "@auth/prisma-client": ["apps/auth/src/generated/prisma-client"],
         "@auth/prisma-client/*": ["apps/auth/src/generated/prisma-client/*"],
         "@user/*": ["apps/user/src/*"],
         "@user/prisma-client": ["apps/user/src/generated/prisma-client"],
         "@user/prisma-client/*": ["apps/user/src/generated/prisma-client/*"],
         "@common": ["libs/common/src"],
         "@common/*": ["libs/common/src/*"],
         "@app/common": ["libs/common/src"],
         "@app/common/*": ["libs/common/src/*"],
         "@notification/*": ["apps/notification/src/*"],
         "@notification/prisma-client": ["apps/notification/src/generated/prisma-client"],
         "@notification/prisma-client/*": ["apps/notification/src/generated/prisma-client/*"],
         "@post/*": ["apps/post/src/*"],
         "@post/prisma-client": ["apps/post/src/generated/prisma-client"],
         "@post/prisma-client/*": ["apps/post/src/generated/prisma-client/*"]
      },
      "jsx": "react-jsx"
   }
}
