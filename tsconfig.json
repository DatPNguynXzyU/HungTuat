{
   "compilerOptions": {
      "module": "nodenext",
      "moduleResolution": "nodenext",
      "resolvePackageJsonExports": true,
      "esModuleInterop": true,
      "isolatedModules": true,
      "declaration": true,
      "removeComments": true,
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "allowSyntheticDefaultImports": true,
      "target": "ES2023",
      "sourceMap": true,
      "outDir": "./dist",
      "baseUrl": "./",
      "incremental": true,
      "skipLibCheck": true,
      "strictNullChecks": true,
      "forceConsistentCasingInFileNames": true,
      "noImplicitAny": true,
      "strictBindCallApply": true,
      "noFallthroughCasesInSwitch": true,
      "paths": {
         "@/*": [
            "apps/gateway/src/*"
         ],
         "@gateway/*": [
            "apps/gateway/src/*"
         ],
         "@auth/*": [
            "apps/auth/src/*"
         ],
         "@common": [
            "libs/common/src"
         ],
         "@common/*": [
            "libs/common/src/*"
         ],
         "@app/common": [
            "libs/common/src"
         ],
         "@app/common/*": [
            "libs/common/src/*"
         ],
         "@notification/*": [
            "apps/notification/src/*"
         ]
      },
      "jsx": "react-jsx"
   }
}
