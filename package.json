{
   "name": "omni-services",
   "version": "0.0.1",
   "description": "",
   "author": "",
   "private": true,
   "license": "UNLICENSED",
   "scripts": {
      "build": "pnpm -r run build",
      "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
      "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
      "test": "jest",
      "test:watch": "jest --watch",
      "test:cov": "jest --coverage",
      "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
      "test:e2e": "for config in apps/*/test/jest-e2e.json; do if [ -f \"$config\" ]; then pnpm exec jest --config \"$config\" || exit 1; fi; done",
      "prisma:generate": "pnpm -r run prisma:generate",
      "prisma:migrate": "pnpm -r run prisma:migrate",
      "prisma:push": "pnpm -r run prisma:push",
      "email:dev": "pnpm --filter @omni/notification run email:dev",
      "codegraph:init": "npx @colbymchenry/codegraph init",
      "codegraph:install": "npx @colbymchenry/codegraph install",
      "codegraph:sync": "npx @colbymchenry/codegraph sync",
      "keys:generate": "ts-node scripts/generate-keys.ts"
   },
   "devDependencies": {
      "@eslint/eslintrc": "^3.2.0",
      "@eslint/js": "^9.18.0",
      "@nestjs/cli": "^11.0.0",
      "@nestjs/schematics": "^11.0.0",
      "@nestjs/testing": "^11.0.1",
      "@react-email/ui": "^6.11.0",
      "@types/amqplib": "^0.10.8",
      "@types/cookie-parser": "^1.4.10",
      "@types/express": "^5.0.0",
      "@types/geoip-lite": "^1.4.4",
      "@types/jest": "^30.0.0",
      "@types/jsonwebtoken": "^9.0.10",
      "@types/node": "^22.10.7",
      "@types/supertest": "^6.0.2",
      "@types/ua-parser-js": "^0.7.39",
      "dotenv-cli": "^11.0.0",
      "eslint": "^9.18.0",
      "eslint-config-prettier": "^10.0.1",
      "eslint-plugin-prettier": "^5.2.2",
      "globals": "^16.0.0",
      "jest": "^30.0.0",
      "pino-pretty": "13.1.3",
      "prettier": "^3.4.2",
      "prisma": "6.19.3",
      "@prisma/client": "6.19.3",
      "react-email": "^6.11.0",
      "source-map-support": "^0.5.21",
      "supertest": "^7.0.0",
      "ts-jest": "^29.2.5",
      "ts-loader": "^9.5.2",
      "ts-node": "^10.9.2",
      "tsconfig-paths": "^4.2.0",
      "typescript": "^5.7.3",
      "typescript-eslint": "^8.20.0"
   },
   "jest": {
      "moduleFileExtensions": [
         "js",
         "json",
         "ts",
         "tsx"
      ],
      "rootDir": ".",
      "testRegex": ".*\\.spec\\.ts$",
      "transform": {
         "^.+\\.(t|j)sx?$": "ts-jest"
      },
      "collectCoverageFrom": [
         "**/*.(t|j)s"
      ],
      "coverageDirectory": "./coverage",
      "testEnvironment": "node",
      "roots": [
         "<rootDir>/apps/",
         "<rootDir>/libs/"
      ],
      "moduleNameMapper": {
         "^@/(.*)$": "<rootDir>/apps/gateway/src/$1",
         "^@gateway/(.*)$": "<rootDir>/apps/gateway/src/$1",
         "^@auth/(.*)$": "<rootDir>/apps/auth/src/$1",
         "^@auth/prisma-client$": "<rootDir>/apps/auth/src/generated/prisma-client",
         "^@auth/prisma-client/(.*)$": "<rootDir>/apps/auth/src/generated/prisma-client/$1",
         "^@common$": "<rootDir>/libs/common/src",
         "^@common/(.*)$": "<rootDir>/libs/common/src/$1",
         "^@app/common$": "<rootDir>/libs/common/src",
         "^@app/common/(.*)$": "<rootDir>/libs/common/src/$1",
         "^@notification/(.*)$": "<rootDir>/apps/notification/src/$1",
         "^@notification/prisma-client$": "<rootDir>/apps/notification/src/generated/prisma-client",
         "^@notification/prisma-client/(.*)$": "<rootDir>/apps/notification/src/generated/prisma-client/$1",
         "^@user/prisma-client$": "<rootDir>/apps/user/src/generated/prisma-client",
         "^@user/prisma-client/(.*)$": "<rootDir>/apps/user/src/generated/prisma-client/$1",
         "@user/(.*)$": "<rootDir>/apps/user/src/$1"
      }
   }
}
