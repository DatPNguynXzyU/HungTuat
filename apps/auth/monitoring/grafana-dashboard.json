            "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
         },
         "title": "Pending Outbox Events",
         "type": "stat",
         "targets": [
            {
               "expr": "auth_outbox_pending_events_total",
               "legendFormat": "Pending Events",
               "refId": "A"
            }
         ]
      },
      {
         "collapsed": false,
         "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
         "id": 5,
         "title": "Authentication & Login Performance",
         "type": "row"
      },
      {
         "datasource": { "type": "prometheus", "uid": "prometheus" },
         "fieldConfig": {
            "defaults": {
               "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
               "unit": "percentunit"
            },
            "overrides": []
         },
         "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
         "id": 6,
         "title": "Login Success Rate",
         "type": "timeseries",
         "targets": [
            {
               "expr": "rate(auth_login_attempts_total{status=\"success\"}[5m]) / (rate(auth_login_attempts_total[5m]) > 0)",
               "legendFormat": "Success Rate",
               "refId": "A"
            }
         ]
      },
      {
         "datasource": { "type": "prometheus", "uid": "prometheus" },
         "fieldConfig": {
            "defaults": {
               "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
               "unit": "s"
            },
            "overrides": []
         },
         "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
         "id": 7,
         "title": "Average Login Duration",
         "type": "timeseries",
         "targets": [
            {
               "expr": "rate(auth_login_duration_seconds_sum[5m]) / rate(auth_login_duration_seconds_count[5m])",
               "legendFormat": "Avg Duration",
               "refId": "A"
            }
         ]
      },
      {
         "datasource": { "type": "prometheus", "uid": "prometheus" },
         "fieldConfig": {
            "defaults": {
               "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
               "unit": "reqps"
            },
            "overrides": []
         },
         "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
         "id": 8,
         "title": "Failed Login Rate by Reason",
         "type": "timeseries",
         "targets": [
            {
               "expr": "rate(auth_login_attempts_total{status=\"failure\"}[5m])",
               "legendFormat": "{{reason}}",
               "refId": "A"
            }
         ]
      },
      {
         "datasource": { "type": "prometheus", "uid": "prometheus" },
         "fieldConfig": {
            "defaults": {
               "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
               "unit": "s"
            },
            "overrides": []
         },
         "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
         "id": 9,
         "title": "Token Generation P95 Latency",
         "type": "timeseries",
         "targets": [
            {
               "expr": "histogram_quantile(0.95, rate(auth_token_generation_duration_seconds_bucket[5m]))",
               "legendFormat": "P95 {{operation}}",
               "refId": "A"
            }
         ]
      },
      {
         "collapsed": false,
         "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
         "id": 10,
         "title": "Registration, Tokens & OTP Operations",
