{
   "name": "@omni/user",
   "version": "0.0.1",
   "private": true,
   "scripts": {
      "start": "nest start user --watch",
      "build": "nest build user",
      "prisma:generate": "dotenv -e .env -- prisma generate --schema=prisma/schema.prisma",
      "prisma:migrate": "dotenv -e .env -- prisma migrate dev --schema=prisma/schema.prisma",
      "prisma:push": "dotenv -e .env -- prisma db push --schema=prisma/schema.prisma",
      "prisma:studio": "dotenv -e .env -- prisma studio --schema=prisma/schema.prisma",
      "lint": "eslint \"src/**/*.ts\" --fix"
   },
   "dependencies": {
      "@common": "workspace:*",
      "@nebula-contrib/nebula-nodejs": "^3.0.3",
      "@nestjs/common": "^11.0.1",
      "@nestjs/config": "^4.0.4",
      "@nestjs/core": "^11.0.1",
      "@nestjs/microservices": "^11.2.6",
      "reflect-metadata": "^0.2.2",
      "rxjs": "^7.8.1",
      "uuidv7": "^1.2.1"
   },
   "devDependencies": {
      "prisma": "6.19.3",
      "@prisma/client": "6.19.3"
   }
}
