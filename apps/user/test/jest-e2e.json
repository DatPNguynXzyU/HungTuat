{
   "moduleFileExtensions": ["js", "json", "ts"],
   "rootDir": ".",
   "testEnvironment": "node",
   "testRegex": ".e2e-spec.ts$",
   "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
   },
   "moduleNameMapper": {
      "^@user/prisma-client$": "<rootDir>/../src/generated/prisma-client",
      "^@user/prisma-client/(.*)$": "<rootDir>/../src/generated/prisma-client/$1",
      "^@user/(.*)$": "<rootDir>/../src/$1",
      "^@gateway/(.*)$": "<rootDir>/../../gateway/src/$1",
      "^@common$": "<rootDir>/../../../libs/common/src",
      "^@common/(.*)$": "<rootDir>/../../../libs/common/src/$1"
   }
}
