datasource db {
   provider = "postgresql"
   url      = env("DATABASE_URL")
}

generator client {
   provider = "prisma-client-js"
   output   = "../src/generated/prisma-client"
}

enum UserStatus {
   ACTIVE
   INACTIVE
   BLOCKED
   SUSPENDED
   PENDING
}

enum OutboxStatus {
   PENDING
   PROCESSING
   PUBLISHED
   FAILED
}

enum FollowStatus {
   PENDING
   ACCEPTED
   REJECTED
   BLOCKED
}

enum Gender {
   MALE
   FEMALE
   OTHER
   PREFER_NOT_TO_SAY
}

// User Profile Model
model User {
   id                String         @id @default(uuid())
   userId            String         @unique // Reference to Auth service user
   email             String?        @unique
   username          String?        @unique
   displayName       String?
   bio               String?        @db.Text
   avatar            String?
   coverImage        String?
   website           String?
   location          String?
   dateOfBirth       DateTime?
   gender            Gender?
   isVerified        Boolean        @default(false)
   isPrivate         Boolean        @default(false)
   status            UserStatus     @default(ACTIVE)

   // Social counts (denormalized for performance)
   followersCount    Int            @default(0)
   followingCount    Int            @default(0)
   postsCount        Int            @default(0)

   // Soft delete
   deletedAt         DateTime?

   // Timestamps
   createdAt         DateTime       @default(now())
   updatedAt         DateTime       @updatedAt
   lastActiveAt      DateTime?

   // Relations
   followers         Follow[]       @relation("UserFollowers")
   following         Follow[]       @relation("UserFollowing")

   @@index([email])
   @@index([username])
   @@index([userId])
   @@index([createdAt])
   @@index([deletedAt])
   @@map("users")
}

// Follow/Social Connection Model
model Follow {
   id                String         @id @default(uuid())
   followerId        String         // User who follows
   followingId       String         // User being followed
   status            FollowStatus   @default(PENDING)

   // Soft delete
   deletedAt         DateTime?

   // Timestamps
   createdAt         DateTime       @default(now())
   updatedAt         DateTime       @updatedAt

   // Relations
   follower          User           @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
   following         User           @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

   @@unique([followerId, followingId])
   @@index([followerId])
   @@index([followingId])
   @@index([status])
   @@index([createdAt])
   @@index([deletedAt])
   @@map("follows")
}

// Outbox Pattern for Event-Driven Architecture
model Outbox {
   id                String         @id @default(uuid())
   aggregateId       String
   aggregateType     String
   eventType         String
   payload           String         @db.Text
   status            OutboxStatus   @default(PENDING)
   retryCount        Int            @default(0)
   maxRetries        Int            @default(3)
   error             String?        @db.Text

   // Timestamps
   createdAt         DateTime       @default(now())
   updatedAt         DateTime       @updatedAt
   publishedAt       DateTime?

   @@index([status, createdAt])
   @@index([aggregateId])
   @@index([eventType])
   @@map("outbox")
}
