# Gateway service name & HTTP server
SERVICE_NAME=api-gateway
PORT=8080
GLOBAL_PREFIX=api/v1

# CORS configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=10
THROTTLE_MEDIUM_TTL=10000
THROTTLE_MEDIUM_LIMIT=50
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=100

# JWT RS256 Verification
JWT_KEY_ID=omni-auth-key-1
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_PATH=apps/gateway/keys/public.key
JWT_ACCESS_TOKEN_EXPIRES_IN=900
JWT_REFRESH_TOKEN_EXPIRES_IN=604800
