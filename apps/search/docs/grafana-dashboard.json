  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Indexing Operations Total",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(search_indexing_total[5m])) by (operation, status)",
          "legendFormat": "{{operation}} - {{status}}"
        }
      ],
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 }
    },
    {
      "title": "Search Query Throughput",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(search_query_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 }
    },
    {
      "title": "Search Query Latency (p95 & p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(search_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(search_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 Latency"
        }
      ],
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 6 }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["search-service", "elasticsearch", "bullmq"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
