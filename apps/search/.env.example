# Search service name
SERVICE_NAME=search-service

# Elasticsearch & Kibana infrastructure
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# Redis (BullMQ queue)
REDIS_HOST=localhost
